{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}{{ if .Root }} (root){{ end }}",
  "palette": {
    "bg": "#00111d",
    "bg_dark": "#000611",
    "bg_alt": "#001e29",
    "neutral": "#003843",
    "selection": "#00313b",
    "fg": "#ffd6a7",
    "fg_bright": "#fff2e0",
    "dim": "#82a6ac",
    "comment": "#4e7a81",
    "primary": "#bdff00",
    "secondary": "#cebef4",
    "info": "#00bafe",
    "success": "#01df72",
    "warning": "#ffbf00",
    "error": "#f04e4f",
    "teal": "#47d6cf",
    "orange": "#fb9d59",
    "pink": "#f383bb"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:fg",
          "background": "p:neutral",
          "template": "{{ if .SSHSession }}  {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:primary",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": "  ",
            "folder_icon": "…"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:bg",
          "background": "p:secondary",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warning{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:error{{ end }}",
            "{{ if gt .Ahead 0 }}p:info{{ end }}",
            "{{ if gt .Behind 0 }}p:pink{{ end }}"
          ],
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true,
            "source": "cli"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:warning",
          "background": "p:neutral",
          "template": "  {{ .FormattedMs }} ",
          "properties": {
            "threshold": 3000,
            "style": "austin"
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:success",
          "background": "p:neutral",
          "template": "  {{ .Full }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:warning",
          "background": "p:neutral",
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "fetch_virtual_env": true
          }
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:teal",
          "background": "p:neutral",
          "template": "  {{ .Full }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:orange",
          "background": "p:neutral",
          "template": "  {{ .Full }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:pink",
          "background": "p:neutral",
          "template": "  {{ .Full }} ",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:dim",
          "background": "p:bg_alt",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "template": "❯",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:primary",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:error{{ end }}"
    ],
    "background": "transparent",
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "p:comment",
    "background": "transparent",
    "template": "❯❯ "
  }
}
