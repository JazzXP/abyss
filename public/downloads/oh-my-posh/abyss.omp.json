{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bar": "#001e29",
    "bg": "#00111d",
    "neutral": "#003843",
    "fg": "#ffd6a7",
    "dim": "#82a6ac",
    "comment": "#4e7a81",
    "primary": "#bdff00",
    "secondary": "#cebef4",
    "info": "#00bafe",
    "success": "#01df72",
    "warning": "#ffbf00",
    "error": "#f04e4f",
    "teal": "#47d6cf",
    "orange": "#fb9d59",
    "pink": "#f383bb"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:bar",
          "foreground": "p:dim",
          "leading_diamond": "\ue0c7\u2593",
          "options": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "style": "diamond",
          "template": " {{ if .WSL }}\ue712 on {{ end }}{{ .Icon }}<#4e7a81> \ue0b1</>",
          "type": "os"
        },
        {
          "background": "p:bar",
          "foreground": "p:fg",
          "style": "diamond",
          "template": " {{ if ne .Env.POSH_SESSION_DEFAULT_USER .UserName }}<#47d6cf>{{ .UserName }}</><#4e7a81>\uf1fa</>{{ end }}<#47d6cf>{{ .HostName }}</><#4e7a81> \ue0b1</>",
          "type": "session"
        },
        {
          "background": "p:bar",
          "foreground": "p:warning",
          "style": "diamond",
          "template": " \uf0e7<#4e7a81> \ue0b1</>",
          "type": "root"
        },
        {
          "background": "p:bar",
          "foreground": "p:fg",
          "options": {
            "folder_icon": "<#cebef4>\ue5fe </>",
            "folder_separator_icon": "<#cebef4>\ue0bf </>",
            "home_icon": "\uf015",
            "style": "agnoster_short"
          },
          "style": "diamond",
          "template": "<#bdff00> \ue5ff </>{{ .Path }} ",
          "type": "path"
        },
        {
          "background": "p:bar",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warning{{ end }}",
            "{{ if gt .Ahead 0 }}p:teal{{ end }}",
            "{{ if gt .Behind 0 }}p:secondary{{ end }}"
          ],
          "style": "diamond",
          "template": "<#4e7a81>\ue0b1 </>{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<#f04e4f> \uf044 {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#01df72> \uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "p:bar",
          "foreground": "p:fg",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "type": "text"
        }
      ],
      "type": "prompt",
      "trailing_diamond": "\ue0b0"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "p:bar",
          "foreground": "p:fg",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "type": "text"
        },
        {
          "background": "p:bar",
          "foreground": "p:success",
          "style": "diamond",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}<#4e7a81> \ue0b3</>",
          "type": "node"
        },
        {
          "background": "p:bar",
          "foreground": "p:secondary",
          "style": "diamond",
          "template": " \ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}<#4e7a81> \ue0b3</>",
          "type": "dotnet"
        },
        {
          "type": "docker",
          "style": "diamond",
          "background": "p:bar",
          "foreground": "p:info",
          "template": " \uf308 {{ .Context }} "
        },
        {
          "background": "p:bar",
          "foreground": "p:orange",
          "style": "diamond",
          "template": " \ue6a3 {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "type": "aws"
        }
      ],
      "type": "prompt",
      "leading_diamond": "\ue0b2"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:comment",
          "style": "plain",
          "template": "~#@<#bdff00>\u276f</>",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "p:comment",
          "style": "plain",
          "template": " \u276e ",
          "type": "text"
        },
        {
          "foreground": "p:warning",
          "options": {
            "style": "roundrock",
            "threshold": 500
          },
          "style": "plain",
          "template": " {{ .FormattedMs }}<#ffd6a7> \uf252 </>",
          "type": "executiontime"
        },
        {
          "foreground": "p:primary",
          "foreground_templates": ["{{ if gt .Code 0 }}p:error{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " \uea9f {{ if gt .Code 0 }}{{ .Code }}{{ end }} ",
          "type": "status"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
  "final_space": true,
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:comment",
    "template": " ~#@<#bdff00>\u276f</> "
  },
  "version": 3
}
